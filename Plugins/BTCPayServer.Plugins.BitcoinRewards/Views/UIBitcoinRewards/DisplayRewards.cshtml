@using BTCPayServer.Plugins.BitcoinRewards.ViewModels
@using System.Globalization
@model DisplayRewardsViewModel
@{
    Layout = null;
    var useCustomTemplate = !string.IsNullOrWhiteSpace(Model.CustomTemplate) && Model.HasReward;
    var useCustomWaitingTemplate = !string.IsNullOrWhiteSpace(Model.WaitingTemplate) && !Model.HasReward && string.IsNullOrEmpty(Model.PendingLightningAddressMasked);

    string ReplaceTokens(string template)
    {
        return template
            .Replace("{AMOUNT_BTC}", Model.RewardAmountBtc.ToString("0.########", CultureInfo.InvariantCulture))
            .Replace("{AMOUNT_SATS}", Model.RewardAmountSatoshis.ToString("N0", CultureInfo.InvariantCulture))
            .Replace("{CLAIM_LINK}", Model.ClaimLink ?? "")
            .Replace("{LNURL}", Model.LnurlString ?? "")
            .Replace("{QR_CODE}", !string.IsNullOrEmpty(Model.LnurlQrDataUri)
                ? $"<img src=\"{Model.LnurlQrDataUri}\" alt=\"Reward QR Code\" style=\"max-width: 420px; width: 100%; height: auto;\" />"
                : "")
            .Replace("{COUNTDOWN_TIMER}", $"<div class=\"countdown-timer\" id=\"countdown-timer\">Time remaining: <span id=\"countdown-seconds\">{Model.RemainingSeconds}</span>s</div>")
            .Replace("{DONE_BUTTON}", "<button class=\"done-button\" id=\"done-button\" onclick=\"hideReward()\">✓ Done</button>");
    }

    string ReplaceWaitingTokens(string template)
    {
        var logoHtml = string.IsNullOrEmpty(Model.LogoUrl)
            ? ""
            : $"<img src=\"{Model.LogoUrl}\" alt=\"{Model.StoreName}\" class=\"logo\">";
        return template
            .Replace("{STORE_NAME}", Model.StoreName ?? "Our Store")
            .Replace("{AUTO_REFRESH_SECONDS}", Model.AutoRefreshSeconds.ToString())
            .Replace("{AUTO_REFRESH_MS}", (Model.AutoRefreshSeconds * 1000).ToString())
            .Replace("{TIMEFRAME_MINUTES}", Model.TimeframeMinutes.ToString())
            .Replace("{PRIMARY_COLOR}", Model.PrimaryColor)
            .Replace("{SECONDARY_COLOR}", Model.SecondaryColor)
            .Replace("{ACCENT_COLOR}", Model.AccentColor)
            .Replace("{LOGO_URL}", Model.LogoUrl ?? "")
            .Replace("{LOGO_HTML}", logoHtml);
    }
}

@if (useCustomWaitingTemplate)
{
    @Html.Raw(ReplaceWaitingTokens(Model.WaitingTemplate!))
}
else if (useCustomTemplate)
{
    @Html.Raw(ReplaceTokens(Model.CustomTemplate!))
    <script>
        let remainingSeconds = @Model.RemainingSeconds;
        const countdownElement = document.getElementById('countdown-seconds');
        function hideReward() {
            fetch('/plugins/bitcoin-rewards/@Model.StoreId/dismiss-reward', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ rewardId: '@Model.RewardId' })
            }).finally(() => window.location.reload());
        }
        function updateCountdown() {
            if (remainingSeconds <= 0) { hideReward(); return; }
            remainingSeconds--;
            if (countdownElement) countdownElement.textContent = remainingSeconds;
            setTimeout(updateCountdown, 1000);
        }
        if (remainingSeconds > 0) setTimeout(updateCountdown, 1000); else hideReward();
        setTimeout(() => window.location.reload(), @Model.AutoRefreshSeconds * 1000);
    </script>
}
else
{
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content="@Model.AutoRefreshSeconds">
    <title>@(Model.StoreName ?? "Bitcoin Rewards")</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { width: 100%; height: 100%; overflow: hidden; }
        body {
            font-family: Inter, 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(180deg, @Model.PrimaryColor 0%, #0d2b20 100%);
            color: #173f2f;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 12px;
        }
        .counter-display {
            width: min(100%, 760px);
            height: calc(100vh - 24px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 14px;
        }
        .brand-logo {
            max-width: 260px;
            max-height: 86px;
            object-fit: contain;
            filter: drop-shadow(0 8px 22px rgba(0,0,0,.18));
        }
        .brand-fallback {
            color: @Model.AccentColor;
            font-size: clamp(2rem, 6vw, 3.4rem);
            font-weight: 850;
            letter-spacing: -.04em;
            text-align: center;
            line-height: 1;
            text-shadow: 0 8px 20px rgba(0,0,0,.22);
        }
        .card {
            width: min(100%, 680px);
            background: #fffaf0;
            border: 3px solid rgba(221, 208, 177, .95);
            border-radius: 28px;
            box-shadow: 0 18px 50px rgba(0,0,0,.28);
            padding: clamp(26px, 5vh, 48px) clamp(24px, 5vw, 54px);
            text-align: center;
        }
        .card.ready { border-color: #c9f25b; box-shadow: 0 18px 54px rgba(201,242,91,.22), 0 18px 50px rgba(0,0,0,.28); }
        .icon { font-size: clamp(3.2rem, 9vw, 5.8rem); line-height: 1; margin-bottom: 12px; }
        h1 {
            color: #173f2f;
            font-size: clamp(2.25rem, 7vw, 4.2rem);
            line-height: .98;
            font-weight: 900;
            letter-spacing: -.055em;
            margin-bottom: 18px;
        }
        .subtext {
            color: #4b2d20;
            font-size: clamp(1.08rem, 3vw, 1.55rem);
            line-height: 1.25;
            font-weight: 650;
        }
        .customer {
            margin: 18px auto 0;
            background: #f4eddf;
            border: 2px solid #173f2f;
            border-radius: 22px;
            padding: 18px;
            color: #173f2f;
        }
        .customer-label { font-size: clamp(1rem, 2.5vw, 1.3rem); font-weight: 750; color: #4b2d20; }
        .customer-address {
            display: block;
            font-size: clamp(1.7rem, 5vw, 3rem);
            font-weight: 900;
            letter-spacing: -.04em;
            margin-top: 6px;
            word-break: break-word;
        }
        .qr-code {
            display: inline-block;
            background: white;
            border-radius: 20px;
            padding: 16px;
            margin: 10px 0 16px;
        }
        .qr-code img { width: min(54vh, 420px); max-width: 100%; height: auto; display: block; }
        .amount { color: #173f2f; font-size: clamp(1.8rem, 5vw, 3rem); font-weight: 900; }
        .small { color: #5f675f; font-size: clamp(.95rem, 2.5vw, 1.15rem); margin-top: 10px; }
        .countdown-timer { color: #4b2d20; font-size: 1rem; font-weight: 700; margin-top: 12px; }
        .hidden-data { display: none; }
        @@media (max-height: 680px) {
            .counter-display { gap: 8px; }
            .brand-logo { max-height: 58px; }
            .card { padding: 22px 24px; border-radius: 24px; }
            .icon { margin-bottom: 8px; }
        }
    </style>
</head>
<body>
    <main class="counter-display">
        @if (!string.IsNullOrEmpty(Model.LogoUrl))
        {
            <img class="brand-logo" src="@Model.LogoUrl" alt="@(Model.StoreName ?? "Store logo")" />
        }
        else if (!string.IsNullOrEmpty(Model.StoreName))
        {
            <div class="brand-fallback">@Model.StoreName</div>
        }

        @if (Model.HasReward && !string.IsNullOrEmpty(Model.LnurlQrDataUri))
        {
            <section class="card reward" id="reward-display">
                <div class="icon">⚡</div>
                <h1>Reward ready</h1>
                <div class="qr-code"><img src="@Model.LnurlQrDataUri" alt="Reward QR Code" /></div>
                <div class="hidden-data" id="nfc-lnurl-data" data-lnurl="@Model.LnurlString" data-reward-id="@Model.RewardId"></div>
                <div class="amount">@Model.RewardAmountSatoshis sats</div>
                @if (!string.IsNullOrEmpty(Model.PullPaymentId))
                {
                    <div class="small">Pull payment: @Model.PullPaymentId</div>
                }
                <div class="countdown-timer" id="countdown-timer">Showing for <span id="countdown-seconds">@Model.RemainingSeconds</span>s</div>
            </section>
        }
        else if (!string.IsNullOrEmpty(Model.PendingLightningAddressMasked))
        {
            <section class="card ready" id="ready-display">
                <div class="icon">✅</div>
                <h1>Ready to reward</h1>
                <div class="customer">
                    <div class="customer-label">Customer checked in</div>
                    <strong class="customer-address">@Model.PendingLightningAddressMasked</strong>
                </div>
                <p class="subtext" style="margin-top:18px;">Next Square payment will issue this reward automatically.</p>
            </section>
        }
        else
        {
            <section class="card waiting" id="waiting-display">
                <div class="icon">☕</div>
                <h1>Waiting for customer</h1>
                <p class="subtext">Scan a wallet Lightning address QR above, then take payment.</p>
            </section>
        }
    </main>

    @if (Model.HasReward && !string.IsNullOrEmpty(Model.LnurlQrDataUri))
    {
        <script>
            let remainingSeconds = @Model.RemainingSeconds;
            const countdownElement = document.getElementById('countdown-seconds');
            function hideReward() {
                fetch('/plugins/bitcoin-rewards/@Model.StoreId/dismiss-reward', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rewardId: '@Model.RewardId' })
                }).finally(() => window.location.reload());
            }
            function updateCountdown() {
                if (remainingSeconds <= 0) { hideReward(); return; }
                remainingSeconds--;
                if (countdownElement) countdownElement.textContent = remainingSeconds;
                setTimeout(updateCountdown, 1000);
            }
            if (remainingSeconds > 0) setTimeout(updateCountdown, 1000); else hideReward();
        </script>
    }
</body>
</html>
}
