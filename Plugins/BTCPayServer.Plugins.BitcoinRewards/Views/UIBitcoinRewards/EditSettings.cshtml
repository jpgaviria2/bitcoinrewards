@using BTCPayServer.Abstractions.Extensions
@model BTCPayServer.Plugins.BitcoinRewards.ViewModels.BitcoinRewardsSettingsViewModel
@{
    ViewData.SetActivePage("BitcoinRewards", "Bitcoin Rewards Settings", "BitcoinRewards");
    ViewData["ActivePage"] = "Settings";
    Layout = "_Layout";
}

<div class="row">
    <div class="sticky-header">
    <h2 class="my-1">Bitcoin Rewards</h2>
    <div class="d-flex gap-2">
        <a asp-controller="CustomerCheckIn" asp-action="Index" asp-route-storeId="@Model.StoreId" class="btn btn-success">Open QR Scanner</a>
        <a asp-action="RewardsHistory" asp-route-storeId="@Model.StoreId" class="btn btn-secondary">View History</a>
        <a asp-action="CreateTestReward" asp-route-storeId="@Model.StoreId" class="btn btn-outline-secondary">Create Test Reward</a>
    </div>
    </div>
</div>

<partial name="_StatusMessage" />
<partial name="_PluginNav" />

<form method="post" asp-action="EditSettings" asp-route-storeId="@Model.StoreId">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-xxl-constrain">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="mb-0">Core Square Rewards</h3>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-check form-switch mb-3">
                        <input type="hidden" name="Enabled" value="false" />
                        <input asp-for="Enabled" class="form-check-input" type="checkbox" value="true" />
                        <label asp-for="Enabled" class="form-check-label">Enable Bitcoin Rewards</label>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input type="hidden" name="EnableSquare" value="false" />
                        <input asp-for="EnableSquare" class="form-check-input" type="checkbox" value="true" />
                        <label asp-for="EnableSquare" class="form-check-label">Enable Square payments</label>
                        <small class="form-text text-muted d-block">Square payment.updated webhooks create rewards after Square marks the payment COMPLETED.</small>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ExternalRewardPercentage">Square Reward Percentage</label>
                        <input asp-for="ExternalRewardPercentage" class="form-control" type="number" step="0.01" min="0" max="100" />
                        <span asp-validation-for="ExternalRewardPercentage" class="text-danger"></span>
                    </div>

                    <input type="hidden" asp-for="BtcpayRewardPercentage" />
                    <input type="hidden" asp-for="DeliveryMethod" />
                    <input type="hidden" asp-for="EnableBtcpay" value="false" />

                    <input type="hidden" asp-for="LegacyPullPaymentFallbackEnabled" value="true" />
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="mb-0">Square API + Webhook</h3>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="SquareApplicationId"></label>
                        <input asp-for="SquareApplicationId" class="form-control" />
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="SquareAccessToken"></label>
                        <input asp-for="SquareAccessToken" class="form-control" type="password" autocomplete="off" placeholder="@(Model.HasSquareAccessToken ? "Saved — leave blank to keep current token" : "Square access token")" />
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="SquareLocationId"></label>
                        <input asp-for="SquareLocationId" class="form-control" />
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="SquareEnvironment"></label>
                        <select asp-for="SquareEnvironment" class="form-select">
                            <option value="production">production</option>
                            <option value="sandbox">sandbox</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="SquareWebhookSignatureKey"></label>
                        <input asp-for="SquareWebhookSignatureKey" class="form-control" type="password" autocomplete="off" placeholder="@(Model.HasSquareWebhookSignatureKey ? "Saved — leave blank to keep current key" : "Webhook signature key")" />
                    </div>
                    <div class="alert alert-secondary">
                        Square webhook endpoint:<br />
                        <code>/plugins/bitcoin-rewards/@Model.StoreId/webhooks/square</code>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="mb-0">In-person scanned Lightning address flow</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-info d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                        <div>
                            <strong>Customer rewards profile scanner</strong><br />
                            Open this on the customer-facing phone/tablet. The customer scans their wallet QR containing a Lightning address; the next Square order will use it for rewards.
                        </div>
                        <a asp-controller="CustomerCheckIn" asp-action="Index" asp-route-storeId="@Model.StoreId" class="btn btn-success btn-lg text-nowrap">Open QR Scanner</a>
                    </div>
                    <div class="alert alert-secondary">
                        Scanner URL:<br />
                        <code>/plugins/bitcoin-rewards/@Model.StoreId/check-in</code>
                        <br />
                        Native Android scanner API:<br />
                        <code>/plugins/bitcoin-rewards/@Model.StoreId/check-in/api</code>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input type="hidden" name="CustomerProfileAssociationEnabled" value="false" />
                        <input asp-for="CustomerProfileAssociationEnabled" class="form-check-input" type="checkbox" value="true" />
                        <label asp-for="CustomerProfileAssociationEnabled" class="form-check-label">Enable exact customer/order association</label>
                        <small class="form-text text-muted d-block">POS/app scans a Trails Lightning address and associates it with a Square order before settlement.</small>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="CustomerProfileApiBaseUrl"></label>
                        <input asp-for="CustomerProfileApiBaseUrl" class="form-control" />
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="CustomerProfileApiToken"></label>
                        <input asp-for="CustomerProfileApiToken" class="form-control" type="password" autocomplete="off" placeholder="@(Model.HasCustomerProfileApiToken ? "Saved — leave blank to keep current token" : "Profile service token")" />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input type="hidden" name="DirectLightningPayoutEnabled" value="false" />
                        <input asp-for="DirectLightningPayoutEnabled" class="form-check-input" type="checkbox" value="true" />
                        <label asp-for="DirectLightningPayoutEnabled" class="form-check-label">Enable direct Lightning payout for associated in-person Square orders</label>
                        <small class="form-text text-muted d-block">When Square marks an associated order paid, BTCPay queues a Lightning payout to the scanned address. This can move funds once Square webhooks arrive.</small>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input type="hidden" name="LegacyPullPaymentFallbackEnabled" value="false" />
                        <input asp-for="LegacyPullPaymentFallbackEnabled" class="form-check-input" type="checkbox" value="true" />
                        <label asp-for="LegacyPullPaymentFallbackEnabled" class="form-check-label">Fallback to email pull payment if direct Lightning payout cannot be queued</label>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="mb-0">Online order email pull payments</h3>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="SelectedPayoutProcessorId"></label>
                        <select asp-for="SelectedPayoutProcessorId" class="form-select">
                            <option value="">-- Auto-select configured payout processor --</option>
                            @foreach (var processor in Model.AvailablePayoutProcessors)
                            {
                                <option value="@processor.ProcessorId">@processor.FriendlyName (@string.Join(", ", processor.SupportedMethods.Select(m => m.ToString())))</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="ServerBaseUrl"></label>
                        <input asp-for="ServerBaseUrl" class="form-control" placeholder="https://your-btcpay.example/" />
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="EmailSubjectOverride"></label>
                        <input asp-for="EmailSubjectOverride" class="form-control" />
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="EmailTemplateOverride"></label>
                        <textarea asp-for="EmailTemplateOverride" class="form-control" rows="8"></textarea>
                        <small class="form-text text-muted">Available placeholders: {CUSTOMER_NAME}, {REWARD_AMOUNT}, {REWARD_SATS}, {CLAIM_LINK}, {QR_CODE}, {ORDER_ID}</small>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="mb-0">Limits + Branding</h3>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="MinimumTransactionAmount"></label>
                        <input asp-for="MinimumTransactionAmount" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="MaximumRewardSatoshis"></label>
                        <input asp-for="MaximumRewardSatoshis" class="form-control" type="number" min="0" />
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="PrimaryColor"></label>
                            <input asp-for="PrimaryColor" class="form-control" type="color" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="SecondaryColor"></label>
                            <input asp-for="SecondaryColor" class="form-control" type="color" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="AccentColor"></label>
                            <input asp-for="AccentColor" class="form-control" type="color" />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="LogoUrl"></label>
                        <input asp-for="LogoUrl" class="form-control" placeholder="https://example.com/logo.svg" />
                        <small class="form-text text-muted">Shown on the counter display above the reward card. SVG, PNG, JPG, and WebP URLs are supported.</small>
                    </div>
                </div>
            </div>

            <button name="command" type="submit" class="btn btn-primary" value="Save">Save Settings</button>
            <button name="command" type="submit" class="btn btn-outline-danger ms-2" value="Reset" onclick="return confirm('Reset Bitcoin Rewards settings for this store?')">Reset</button>
        </div>
    </div>
</form>

<div class="row mt-4">
    <div class="col-xxl-constrain">
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="mb-0">10 sat test rewards</h3>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">Use these only for live operational testing. Each action creates a one-time reward using the configured test amount.</p>
                <form method="post" asp-action="UpdateTestRewardAmount" asp-route-storeId="@Model.StoreId" class="row g-2 align-items-end mb-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4">
                        <label asp-for="TestRewardSatoshis" class="form-label"></label>
                        <input asp-for="TestRewardSatoshis" class="form-control" type="number" min="1" max="100000" />
                    </div>
                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-outline-secondary">Save test amount</button>
                    </div>
                    <div class="col-12">
                        <small class="form-text text-muted">Default is 10 sats. Raise it if BTCPay or the destination rejects the payout as too low.</small>
                    </div>
                </form>
                <div class="d-flex flex-wrap gap-2 align-items-start mb-3">
                    @if (Model.OneTimeScannedAddressTestEnabled)
                    {
                        <form method="post" asp-action="CancelScanTest" asp-route-storeId="@Model.StoreId">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning">Cancel armed scan test</button>
                        </form>
                        <span class="badge bg-info text-dark align-self-center">Armed: next captured Lightning address receives 10 sats</span>
                    }
                    else
                    {
                        <form method="post" asp-action="ArmScanTest" asp-route-storeId="@Model.StoreId">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary">Start one-time scanned address test</button>
                        </form>
                    }

                    <form method="post" asp-action="DisplayPullPaymentTest" asp-route-storeId="@Model.StoreId">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary">Create 10 sat display pull payment</button>
                    </form>
                </div>

                <form method="post" asp-action="EmailFlowTest" asp-route-storeId="@Model.StoreId" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label for="testEmail" class="form-label">Test email</label>
                        <input id="testEmail" name="testEmail" type="email" class="form-control" placeholder="customer@example.com" />
                    </div>
                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-outline-primary">Send 10 sat email-flow test</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
